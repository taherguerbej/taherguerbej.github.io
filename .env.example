# Copy this file to `.env.local`. `.env*` is gitignored.
# Both variables are optional; the site builds and runs without them.

# Your live domain, no trailing slash. Drives the sitemap, robots.txt, the
# canonical URL and the Open Graph image URL. Set it before deploying.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Google Search Console verification token (the `content` value of the
# google-site-verification meta tag). Leave unset and no tag is rendered.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
